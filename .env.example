# ========================================================
# Mode 1: Self-Signed Encryption (No Domain Needed)
# ========================================================
# Use this mode if you just want to access it via an IP address.
# The connection will be encrypted, but your browser will show a warning
# that the certificate is self-signed (which you can safely accept).

DOMAIN=:443
TLS_EMAIL=internal


# ========================================================
# Mode 2: Official SSL Certificate (Requires Real Domain)
# ========================================================
# To use Let's Encrypt for a real domain, comment out Mode 1 above
# and uncomment the lines below, putting your real domain and email.

# DOMAIN=powerk.yourdomain.com
# TLS_EMAIL=your-email@example.com
